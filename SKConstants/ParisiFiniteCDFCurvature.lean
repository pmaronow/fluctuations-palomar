module

public import SKConstants.Upstream.OAI.Probability.SKSupport.Density.FiniteDensity
public import Mathlib.Probability.CDF

@[expose] public section

/-!
Finite-temperature specialization of OpenAI's finite log-cosh curvature certificate.
The coefficients below are constructed from an actual probability measure, with a
positive regularization.  The process is the proved Brownian feedback diffusion,
and its terminal condition is `log (2 * cosh x)`, rather than the zero-temperature
absolute-value terminal condition.  No support or stationarity property is assumed.
-/

open MeasureTheory ProbabilityTheory Set Filter
open scoped NNReal ENNReal Topology ContDiff
noncomputable section

namespace SKConstants.ParisiFullSupport

open SKConstantsOAI.ZeroTemperatureSK SKConstantsOAI.ZeroTemperatureSK.Heat

def positiveCDFCoefficient (μ : ProbabilityMeasure ℝ) (N : ℕ) (ε : ℝ) (k : ℕ) : ℝ≥0 :=
  Real.toNNReal ((ε + cdf (μ : Measure ℝ) ((k : ℝ) / N)) / (1 + ε))

lemma positiveCDFCoefficient_coe (μ : ProbabilityMeasure ℝ) (N : ℕ) {ε : ℝ}
    (hε : 0 < ε) (k : ℕ) :
    (positiveCDFCoefficient μ N ε k : ℝ) =
      (ε + cdf (μ : Measure ℝ) ((k : ℝ) / N)) / (1 + ε) := by
  apply Real.coe_toNNReal
  exact (div_pos (add_pos_of_pos_of_nonneg hε (cdf_nonneg _ _)) (by linarith)).le

lemma positiveCDFCoefficient_pos (μ : ProbabilityMeasure ℝ) (N : ℕ) {ε : ℝ}
    (hε : 0 < ε) (k : ℕ) : 0 < (positiveCDFCoefficient μ N ε k : ℝ) := by
  rw [positiveCDFCoefficient_coe μ N hε]
  exact div_pos (add_pos_of_pos_of_nonneg hε (cdf_nonneg _ _)) (by linarith)

lemma positiveCDFCoefficient_le_one (μ : ProbabilityMeasure ℝ) (N : ℕ) {ε : ℝ}
    (hε : 0 < ε) (k : ℕ) : (positiveCDFCoefficient μ N ε k : ℝ) ≤ 1 := by
  rw [positiveCDFCoefficient_coe μ N hε, div_le_one (by linarith : 0 < 1 + ε)]
  linarith [cdf_le_one (μ : Measure ℝ) ((k : ℝ) / N)]

lemma positiveCDFCoefficient_monotone (μ : ProbabilityMeasure ℝ) (N : ℕ) {ε : ℝ}
    (hε : 0 < ε) : Monotone (positiveCDFCoefficient μ N ε) := by
  intro k l hkl
  apply NNReal.coe_le_coe.mp
  rw [positiveCDFCoefficient_coe μ N hε, positiveCDFCoefficient_coe μ N hε]
  apply div_le_div_of_nonneg_right _ (by linarith)
  exact add_le_add_right ((cdf (μ : Measure ℝ)).mono
    (div_le_div_of_nonneg_right (Nat.cast_le.mpr hkl) (Nat.cast_nonneg N))) ε

lemma positiveCDFCoefficient_error (μ : ProbabilityMeasure ℝ) (N : ℕ) {ε : ℝ}
    (hε : 0 < ε) (k : ℕ) :
    |(positiveCDFCoefficient μ N ε k : ℝ) -
      cdf (μ : Measure ℝ) ((k : ℝ) / N)| ≤ ε := by
  rw [positiveCDFCoefficient_coe μ N hε]
  let a := cdf (μ : Measure ℝ) ((k : ℝ) / N)
  have ha0 : 0 ≤ a := cdf_nonneg _ _
  have ha1 : a ≤ 1 := cdf_le_one _ _
  have hden : 0 < 1 + ε := by linarith
  have he : (ε + a) / (1 + ε) - a = ε * (1 - a) / (1 + ε) := by
    field_simp
    ring
  change |(ε + a) / (1 + ε) - a| ≤ ε
  rw [he, abs_of_nonneg (by positivity)]
  apply (div_le_iff₀ hden).mpr
  nlinarith

/-- The finite-temperature scalar terminal function is exactly the one used by
the source, including the `log 2` convention. -/
lemma softAbs_one (x : ℝ) : softAbs 1 x = Real.log (2 * Real.cosh x) := by
  simp [softAbs]

/-- A quantitative curvature certificate for the literal Brownian feedback
process generated by a finite mesh of a probability CDF. -/
theorem finiteCDF_feedback_coercivity {Ω : Type*} [MeasurableSpace Ω]
    (W : BrownianSystem Ω) (μ : ProbabilityMeasure ℝ) (N : ℕ) {ε : ℝ}
    (hε : 0 < ε) {h : ℝ≥0} (hh : 0 < (h : ℝ)) {i : ℕ}
    (hi : 0 < i) (hiN : i ≤ N) :
    let c := positiveCDFCoefficient μ N ε
    let X := (finiteFeedback (regularDatum_softAbs (by norm_num : (1 : ℝ) ≠ 0))
      (softAbs_lipschitz (by norm_num : (1 : ℝ) ≠ 0)) c h N 0).solution W.driver
    let r := fun x => (c i : ℝ) * deriv (backwardBoundary c h (softAbs 1) N i) x
    (1 / 1000 : ℝ) * (∫ w, quarticMoment r (X ((i : ℝ≥0) * h) w) ∂W.law) ≤
      ∫ w, coercivePolynomial r (X ((i : ℝ≥0) * h) w) ∂W.law := by
  exact finite_feedback_coercivity W (positiveCDFCoefficient μ N ε)
    (positiveCDFCoefficient_pos μ N hε) (positiveCDFCoefficient_monotone μ N hε)
    (positiveCDFCoefficient_le_one μ N hε) hh hi hiN

end SKConstants.ParisiFullSupport
